+// scripts/perp-doctor.ts prints prices at the market's tick precision. Runs the
+// real script against a stubbed exchange: no network, no key.
+
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+const h = vi.hoisted(() => ({ lines: [] as string[], done: () => {} }));
+
+const market = (display: string, tickSize: string, bid: number, ask: number, mark: number) => ({
+  display,
+  symbol: `${display}/USDso:USDso`,
+  bid,
+  ask,
+  mark,
+  info: {
+    tickSize,
+    lotSize: "1",
+    minQuantity: "1",
+    baseDecimals: 18,
+    quoteDecimals: 18,
+    initialMarginBps: 1000,
+    markPrice: "0",
+    quoteToken: "0x0000000000000000000000000000000000000001",
+  },
+});
+
+// Top of book as the chain had it on 2026-10-29 (report 001).
+const MARKETS = [
+  market("XRP-PERP", "100000000000000", 1.309, 1.3133, 1.3111), // tick 0.0001
+  market("1000PEPE-PERP", "100000000000", 0.0047164, 0.0047448, 0.0047301), // tick 0.0000001
+  market("BTC-PERP", "100000000000000000", 78283.1, 78290.4, 78286.7), // tick 0.1
+];
+
+vi.mock("@dreamdex-bot-kit/perp-core", () => {
+  const find = (symbol: string) => MARKETS.find((m) => m.symbol === symbol)!;
+  return {
+    loadConfig: () => ({ network: "hideki", chainId: 50383, indexerUrl: "stub" }),
+    createExchange: () => ({
+      exchange: {
+        walletAddress: undefined,
+        fetchOrderBook: async (symbol: string) => ({ bids: [[find(symbol).bid, 1]], asks: [[find(symbol).ask, 1]] }),
+      },
+    }),
+    shutdown: async () => h.done(),
+    perpMarkets: async () => MARKETS,
+    liveMark: async (_: unknown, m: (typeof MARKETS)[number]) => m.mark,
+    markOf: () => 0,
+    liveFunding: async () => ({ known: false }),
+    pendingStops: async () => [],
+    requireMarket: vi.fn(),
+    marginSnapshot: vi.fn(),
+    healthRatio: vi.fn(),
+    linkCoverage: vi.fn(),
+  };
+});
+
+afterEach(() => vi.restoreAllMocks());
+
+describe("perp:doctor price format", () => {
+  it("prints mark, bid and ask with as many decimals as the tick has", async () => {
+    vi.spyOn(process, "exit").mockImplementation((() => undefined) as never);
+    vi.spyOn(console, "log").mockImplementation((...a: unknown[]) => void h.lines.push(a.join(" ")));
+    const finished = new Promise<void>((r) => (h.done = r));
+    await import("../../../scripts/perp-doctor.ts");
+    await finished;
+
+    const line = (name: string) => h.lines.find((l) => l.startsWith(name)) ?? "";
+    expect(line("XRP-PERP")).toContain("book[bid=1.3090 ask=1.3133]");
+    expect(line("XRP-PERP")).toContain("mark=1.3111 ");
+    expect(line("1000PEPE-PERP")).toContain("book[bid=0.0047164 ask=0.0047448]");
+    expect(line("BTC-PERP")).toContain("book[bid=78283.1 ask=78290.4]");
+  });
+});
