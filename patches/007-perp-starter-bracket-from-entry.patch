+
+// strategies/perp-starter: where the bracket goes. Runs the real strategy with
+// the default 2% take-profit and 1% stop-loss against stubbed perp-core calls,
+// so nothing touches the network.
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+type Pos = { symbol: string; side: "long" | "short"; contracts: number; entryPrice: number };
+
+const h = vi.hoisted(() => ({
+  done: () => {},
+  owner: undefined as string | undefined,
+  positions: [] as (Pos | undefined)[], // successive positionIn() answers, the last one repeats
+  marks: { start: 0, watch: 0 }, // liveMark() before the watch loop, and inside it
+  armBracket: undefined as unknown as ReturnType<typeof vi.fn>,
+  closePosition: undefined as unknown as ReturnType<typeof vi.fn>,
+  cycles: 0,
+}));
+
+const SYMBOL = "BTC/USDso:USDso";
+const human = (v: bigint) => Number(v) / 1e18;
+
+vi.mock("@dreamdex-bot-kit/perp-core", async (importOriginal) => {
+  const real = await importOriginal<typeof import("../src/index.js")>();
+  const next = <T>(list: T[]) => (list.length > 1 ? list.shift()! : list[0]!);
+  const market = {
+    symbol: SYMBOL,
+    display: "BTC-PERP",
+    info: { tickSize: "10000000000000000", baseSymbol: "BTC", baseDecimals: 8, markPrice: "0" },
+  };
+  return {
+    ...real,
+    loadEnv: () => {},
+    createExchange: () => ({
+      exchange: {
+        walletAddress: "0x00000000000000000000000000000000000000aa",
+        fetchOrderBook: async () => ({ bids: [[99_990, 1]], asks: [[100_010, 1]] }),
+      },
+      config: { dryRun: false, owner: h.owner, symbol: "BTC-PERP" },
+    }),
+    onStop: () => () => h.cycles >= 1,
+    sleep: async () => void h.cycles++,
+    requireMarket: async () => market,
+    tradingKeyCheck: async () => ({ ok: true }),
+    preflight: async () => ({ ok: true, message: "preflight ok" }),
+    somiPerStop: async () => 0n,
+    ensureLeverage: async () => ({ dryRun: false, changed: false, to: 2 }),
+    positionIn: async () => next(h.positions),
+    liveMark: async () => (h.cycles === 0 ? h.marks.start : h.marks.watch),
+    sizeForNotional: () => 50_000n,
+    sizeOrder: async () => ({ ok: true, quantity: 50_000n }),
+    placePerp: async () => ({ sent: true, orderId: 1n, filled: 50_000n }),
+    pendingStops: async () => [],
+    cancelStops: async () => {},
+    armBracket: (h.armBracket = vi.fn(async () => ({ sent: true }))),
+    closePosition: (h.closePosition = vi.fn(async () => ({ sent: true, filled: 50_000n }))),
+    shutdown: async () => h.done(),
+  };
+});
+
+async function runStarter(env: Record<string, string>): Promise<void> {
+  for (const [k, v] of Object.entries(env)) vi.stubEnv(k, v);
+  const finished = new Promise<void>((r) => (h.done = r));
+  vi.resetModules();
+  await import("../../../strategies/perp-starter/src/index.ts");
+  await finished;
+}
+
+beforeEach(() => {
+  h.cycles = 0;
+  h.owner = undefined;
+  vi.spyOn(process, "exit").mockImplementation((() => undefined) as never);
+  vi.spyOn(console, "log").mockImplementation(() => {});
+});
+
+afterEach(() => {
+  vi.unstubAllEnvs();
+  vi.restoreAllMocks();
+});
+
+describe("perp-starter bracket", () => {
+  it("opens a short and arms take-profit 2% under and stop-loss 1% over the entry price", async () => {
+    // No position before the open; the short fills at 100,000 while the mark reads 100,500.
+    h.positions = [undefined, { symbol: SYMBOL, side: "short", contracts: 0.0005, entryPrice: 100_000 }];
+    h.marks = { start: 100_500, watch: 100_500 };
+    await runStarter({ DRY_RUN: "false", PERP_SIDE: "short" });
+
+    const args = h.armBracket.mock.calls[0]![0];
+    expect(args.position).toBe("short");
+    expect(human(args.takeProfit)).toBeCloseTo(98_000, 2);
+    expect(human(args.stopLoss)).toBeCloseTo(101_000, 2);
+  });
+
+  it("manages an existing short as a short even when PERP_SIDE says long", async () => {
+    h.positions = [{ symbol: SYMBOL, side: "short", contracts: 0.0005, entryPrice: 100_000 }];
+    h.marks = { start: 100_500, watch: 100_500 };
+    await runStarter({ DRY_RUN: "false", PERP_SIDE: "long" });
+
+    const args = h.armBracket.mock.calls[0]![0];
+    expect(args.position).toBe("short");
+    expect(human(args.takeProfit)).toBeCloseTo(98_000, 2);
+    expect(human(args.stopLoss)).toBeCloseTo(101_000, 2);
+  });
+
+  it("with a trading key, closes an existing short in profit as a take-profit", async () => {
+    h.owner = "0x00000000000000000000000000000000000000bb";
+    h.positions = [{ symbol: SYMBOL, side: "short", contracts: 0.0005, entryPrice: 100_000 }];
+    h.marks = { start: 100_500, watch: 97_900 }; // the mark then falls 2.1% under the entry
+    await runStarter({ DRY_RUN: "false", PERP_SIDE: "long" });
+
+    expect(h.armBracket).not.toHaveBeenCalled();
+    expect(h.closePosition).toHaveBeenCalledTimes(1);
+    expect(h.closePosition.mock.calls[0]![3]).toEqual({ label: "take-profit" });
+  });
+});
